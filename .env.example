# ===========================================
# SpaFlow AI - Environment Variables Template
# Copy file này thành .env.local và điền giá trị thật
# ===========================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Bắt buộc cho Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bảo mật mã hóa API Keys (32 bytes hex / 64 ký tự hex cho AES-256-GCM)
ENCRYPTION_SECRET_KEY=replace-with-64-char-hex-secret-key

# Bảo mật Cron Job (/api/cron/reminders)
CRON_SECRET=replace-with-strong-cron-secret

# AI & Marketing (Phase 4E)
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_TTS_API_KEY=your-google-cloud-tts-api-key

# Email mặc định hệ thống (Phase 4D)
RESEND_API_KEY=your-resend-api-key
